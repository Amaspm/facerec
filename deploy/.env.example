# Port mapping (hindari port <1024 di rootless Podman)
HTTP_PORT=8080
HTTPS_PORT=8443

# Auth — WAJIB diubah sebelum production
ADMIN_PASSWORD=ganti_password_ini
# Hasilkan dengan: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti_secret_key_panjang_acak_ini

# Token expiry dalam menit (default 480 = 8 jam)
JWT_EXPIRE_MINUTES=480

# Timezone server (sesuaikan dengan lokasi Anda)
TZ=Asia/Jakarta
