# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
build/
*.egg

# ── Virtual environment ───────────────────────────────────────────────────────
venv/
.venv/
env/
.env.local

# ── Data persisten (database & face samples) ─────────────────────────────────
# File ini ada di data/ saat dev lokal dan di Podman volume saat production.
# Jangan pernah di-commit — berisi data biometrik dan absensi.
data/*.db
data/*.pkl
data/*.sqlite3

# Pastikan folder data/ sendiri tetap ada di repo (via .gitkeep)
!data/.gitkeep

# ── Environment / secret ──────────────────────────────────────────────────────
deploy/.env
# TLS certs (di-generate lokal, bukan bagian kode)
deploy/certs/*.pem
deploy/certs/*.key
deploy/certs/cert.pem
deploy/certs/key.pem

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
.npm/

# ── IDE & OS ──────────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
Thumbs.db

# ── Test cache ────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
*.tmp
